{
  "name": "cafe-babuska",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4300",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "smoke:content:setup": "node --env-file=.env.local scripts/smoke-content.mjs setup",
    "smoke:content:cleanup": "node --env-file=.env.local scripts/smoke-content.mjs cleanup",
    "smoke:content": "npm run smoke:content:setup && npm run smoke:content:cleanup",
    "smoke:public-bootstrap": "node --env-file=.env.local scripts/smoke-public-bootstrap.mjs",
    "smoke:admin-content-media": "node --env-file=.env.local scripts/smoke-admin-content-media.mjs",
    "smoke:responsive": "node scripts/smoke-responsive.mjs",
    "smoke:performance": "node scripts/smoke-performance.mjs",
    "check:local": "npm run check && npm run smoke:public-bootstrap && npm run smoke:content && npm run smoke:admin-content-media && npm run smoke:responsive && npm run smoke:performance",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo-content.mjs && node --env-file=.env.local scripts/backfill-media-variants.mjs --refresh-hero",
    "migrate:media": "node --env-file=.env.local scripts/migrate-content-media.mjs",
    "backfill:media-variants": "node --env-file=.env.local scripts/backfill-media-variants.mjs",
    "sync:canva-menu": "node --env-file=.env.local scripts/sync-canva-menu.mjs",
    "setup:local-admin": "node --env-file=.env.local scripts/setup-local-admin.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4300",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "playwright": "^1.55.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^3.2.4",
    "ws": "^8.21.3"
  }
}
