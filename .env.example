# Public browser configuration. Never put a secret/service key in VITE_ variables.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-local-anon-key

# Used only by local/server-side maintenance scripts; do not deploy these to Vercel.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=your-local-service-role-key
SUPABASE_ADMIN_EMAIL=admin@cafebabuska.local
SUPABASE_ADMIN_PASSWORD=choose-a-strong-local-password
